generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")

  @@map("organization_status")
}

enum MembershipRole {
  OWNER     @map("owner")
  ADMIN     @map("admin")
  COACH     @map("coach")
  ASSISTANT @map("assistant")
  CLIENT    @map("client")

  @@map("membership_role")
}

enum MembershipStatus {
  INVITED   @map("invited")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REMOVED   @map("removed")

  @@map("membership_status")
}

enum ClientStatus {
  ACTIVE      @map("active")
  ARCHIVED    @map("archived")
  NEW         @map("new")
  DEACTIVATED @map("deactivated")

  @@map("client_status")
}

enum LeadStatus {
  HOT  @map("hot")
  WARM @map("warm")
  COLD @map("cold")

  @@map("lead_status")
}

enum LeadStage {
  INITIAL_CONTACT @map("initial-contact")
  CONSULTATION    @map("consultation")
  PROPOSAL        @map("proposal")
  NEGOTIATION     @map("negotiation")
  CLOSED_WON      @map("closed-won")

  @@map("lead_stage")
}

enum LeadActivityType {
  NOTE             @map("note")
  EMAIL            @map("email")
  CALL             @map("call")
  STAGE_TRANSITION @map("stage-transition")

  @@map("lead_activity_type")
}

enum FormType {
  CHECK_IN      @map("check-in")
  INTAKE        @map("intake")
  APPLICATION   @map("application")
  CONTACT       @map("contact")
  HABIT_TRACKER @map("habit-tracker")

  @@map("form_type")
}

enum FormStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("form_status")
}

enum FormAssignmentStatus {
  ASSIGNED  @map("assigned")
  SUBMITTED @map("submitted")
  REVIEWED  @map("reviewed")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("form_assignment_status")
}

enum FormSubmissionStatus {
  SUBMITTED @map("submitted")
  REVIEWED  @map("reviewed")
  COMPLETED @map("completed")

  @@map("form_submission_status")
}

enum CheckInStatus {
  PENDING_REVIEW @map("pending-review")
  REVIEWED       @map("reviewed")
  COMPLETED      @map("completed")

  @@map("check_in_status")
}

enum ExternalApiKeyStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")
  EXPIRED @map("expired")

  @@map("external_api_key_status")
}

enum ExternalExportType {
  METRICS          @map("metrics")
  CLIENTS          @map("clients")
  FORM_SUBMISSIONS @map("form-submissions")
  CHECK_INS        @map("check-ins")

  @@map("external_export_type")
}

enum ExternalExportFormat {
  JSON  @map("json")
  JSONL @map("jsonl")
  CSV   @map("csv")

  @@map("external_export_format")
}

enum ExternalExportStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("external_export_status")
}

enum ExternalWebhookEndpointStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("external_webhook_endpoint_status")
}

enum ExternalWebhookDeliveryStatus {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("external_webhook_delivery_status")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String?                  @unique
  emailVerified           DateTime?                @map("email_verified") @db.Timestamptz(6)
  image                   String?                  @map("image_url")
  passwordHash            String?                  @map("password_hash")
  authProvider            String?                  @map("auth_provider")
  authProviderAccountId   String?                  @map("auth_provider_account_id")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts                Account[]
  sessions                Session[]
  memberships             OrganizationMembership[] @relation("MembershipUser")
  invitedMemberships      OrganizationMembership[] @relation("MembershipInviter")
  auditLogs               AuditLog[]
  clients                 Client[]                 @relation("ClientPortalUser")
  coachedClients          Client[]                 @relation("ClientPrimaryCoach")
  assignedLeads           Lead[]                   @relation("LeadAssignee")
  leadActivities          LeadActivity[]
  createdForms            Form[]                   @relation("FormCreator")
  createdFormVersions     FormVersion[]            @relation("FormVersionCreator")
  createdFormAssignments  FormAssignment[]         @relation("FormAssignmentCreator")
  submittedForms          FormSubmission[]         @relation("FormSubmissionSubmitter")
  reviewedFormSubmissions FormSubmission[]         @relation("FormSubmissionReviewer")
  reviewedCheckIns        CheckIn[]                @relation("CheckInReviewer")

  @@unique([authProvider, authProviderAccountId])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id                        String                    @id @default(cuid())
  name                      String
  slug                      String                    @unique
  status                    OrganizationStatus        @default(ACTIVE)
  timezone                  String                    @default("UTC")
  stripeConnectAccountId    String?                   @map("stripe_connect_account_id")
  stripeConnectStatus       String?                   @map("stripe_connect_status")
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                 DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  memberships               OrganizationMembership[]
  auditLogs                 AuditLog[]
  clients                   Client[]
  clientProfiles            ClientProfile[]
  leads                     Lead[]
  leadActivities            LeadActivity[]
  forms                     Form[]
  formVersions              FormVersion[]
  formAssignments           FormAssignment[]
  formSubmissions           FormSubmission[]
  checkIns                  CheckIn[]
  clientMeasurements        ClientMeasurement[]
  externalApiKeys           ExternalApiKey[]
  externalExportJobs        ExternalExportJob[]
  externalWebhookEndpoints  ExternalWebhookEndpoint[]
  externalWebhookDeliveries ExternalWebhookDelivery[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  userId          String           @map("user_id")
  role            MembershipRole
  status          MembershipStatus @default(INVITED)
  invitedByUserId String?          @map("invited_by_user_id")
  joinedAt        DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy       User?            @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId, status])
  @@index([invitedByUserId])
  @@map("organization_memberships")
}

model AuditLog {
  id             String          @id @default(cuid())
  organizationId String?         @map("organization_id")
  actorUserId    String?         @map("actor_user_id")
  action         String
  targetType     String?         @map("target_type")
  targetId       String?         @map("target_id")
  actorApiKeyId  String?         @map("actor_api_key_id")
  metadata       Json?
  ipAddress      String?         @map("ip_address")
  userAgent      String?         @map("user_agent")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiKey    ExternalApiKey? @relation(fields: [actorApiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorApiKeyId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Client {
  id                 String              @id @default(cuid())
  organizationId     String              @map("organization_id")
  clientUserId       String?             @map("client_user_id")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  email              String?
  phone              String?
  status             ClientStatus        @default(NEW)
  packageId          String?             @map("package_id")
  packageName        String?             @map("package_name")
  primaryCoachUserId String?             @map("primary_coach_user_id")
  checkInDay         String?             @map("check_in_day")
  timezone           String              @default("UTC")
  startDate          DateTime?           @map("start_date") @db.Date
  latestCheckInAt    DateTime?           @map("latest_check_in_at") @db.Timestamptz(6)
  compliance         Int                 @default(0)
  externalClientId   String?             @map("external_client_id")
  archivedAt         DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientUser         User?               @relation("ClientPortalUser", fields: [clientUserId], references: [id], onDelete: SetNull)
  primaryCoach       User?               @relation("ClientPrimaryCoach", fields: [primaryCoachUserId], references: [id], onDelete: SetNull)
  profile            ClientProfile?
  formAssignments    FormAssignment[]
  formSubmissions    FormSubmission[]
  checkIns           CheckIn[]
  measurements       ClientMeasurement[]

  @@unique([organizationId, externalClientId])
  @@index([organizationId, status])
  @@index([organizationId, primaryCoachUserId])
  @@index([organizationId, checkInDay])
  @@index([clientUserId])
  @@map("clients")
}

model ClientProfile {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  clientId         String       @unique @map("client_id")
  dateOfBirth      DateTime?    @map("date_of_birth") @db.Date
  sex              String?
  goals            Json?
  injuries         Json?
  medicalNotes     String?      @map("medical_notes") @db.Text
  bio              String?      @db.Text
  emergencyContact Json?        @map("emergency_contact")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
  @@map("client_profiles")
}

model Lead {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  email          String?
  phone          String?
  source         String?
  status         LeadStatus     @default(WARM)
  stage          LeadStage      @default(INITIAL_CONTACT)
  location       String?
  notes          String?        @db.Text
  lastContactAt  DateTime?      @map("last_contact_at") @db.Timestamptz(6)
  daysInStage    Int            @default(0) @map("days_in_stage")
  assignedUserId String?        @map("assigned_user_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser   User?          @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]

  @@index([organizationId, stage])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, email])
  @@map("leads")
}

model LeadActivity {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  leadId         String           @map("lead_id")
  actorUserId    String?          @map("actor_user_id")
  type           LeadActivityType
  body           String?          @db.Text
  occurredAt     DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor          User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("lead_activities")
}

model Form {
  id               String           @id @default(cuid())
  organizationId   String           @map("organization_id")
  name             String
  description      String?          @db.Text
  type             FormType
  status           FormStatus       @default(DRAFT)
  currentVersionId String?          @unique @map("current_version_id")
  createdByUserId  String?          @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?            @relation("FormCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentVersion   FormVersion?     @relation("CurrentFormVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         FormVersion[]    @relation("FormVersions")
  assignments      FormAssignment[]
  submissions      FormSubmission[]

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([createdByUserId])
  @@map("forms")
}

model FormVersion {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  formId          String           @map("form_id")
  versionNumber   Int              @map("version_number")
  schemaJson      Json             @map("schema_json")
  uiJson          Json?            @map("ui_json")
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(6)
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form            Form             @relation("FormVersions", fields: [formId], references: [id], onDelete: Cascade)
  currentForForm  Form?            @relation("CurrentFormVersion")
  createdBy       User?            @relation("FormVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignments     FormAssignment[]
  submissions     FormSubmission[]

  @@unique([formId, versionNumber])
  @@index([organizationId, formId])
  @@index([createdByUserId])
  @@map("form_versions")
}

model FormAssignment {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  formId          String               @map("form_id")
  formVersionId   String               @map("form_version_id")
  clientId        String               @map("client_id")
  status          FormAssignmentStatus @default(ASSIGNED)
  dueAt           DateTime?            @map("due_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdByUserId String?              @map("created_by_user_id")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form            Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion     FormVersion          @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("FormAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submissions     FormSubmission[]

  @@index([organizationId, clientId, status, dueAt])
  @@index([organizationId, formId, status])
  @@index([formVersionId])
  @@index([createdByUserId])
  @@map("form_assignments")
}

model FormSubmission {
  id                String               @id @default(cuid())
  organizationId    String               @map("organization_id")
  formId            String               @map("form_id")
  formVersionId     String               @map("form_version_id")
  assignmentId      String?              @map("assignment_id")
  clientId          String               @map("client_id")
  submittedByUserId String?              @map("submitted_by_user_id")
  answersJson       Json                 @map("answers_json")
  status            FormSubmissionStatus @default(SUBMITTED)
  submittedAt       DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId  String?              @map("reviewed_by_user_id")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form              Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion       FormVersion          @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  assignment        FormAssignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submittedBy       User?                @relation("FormSubmissionSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy        User?                @relation("FormSubmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  checkIn           CheckIn?

  @@index([organizationId, clientId, submittedAt])
  @@index([organizationId, status, submittedAt])
  @@index([organizationId, formId, submittedAt])
  @@index([formVersionId])
  @@index([assignmentId])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@map("form_submissions")
}

model CheckIn {
  id               String          @id @default(cuid())
  organizationId   String          @map("organization_id")
  clientId         String          @map("client_id")
  formSubmissionId String?         @unique @map("form_submission_id")
  type             String          @default("check-in")
  status           CheckInStatus   @default(PENDING_REVIEW)
  dueAt            DateTime?       @map("due_at") @db.Timestamptz(6)
  submittedAt      DateTime?       @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId String?         @map("reviewed_by_user_id")
  summary          String?         @db.Text
  coachNotes       String?         @map("coach_notes") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  reviewedBy       User?           @relation("CheckInReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, clientId, submittedAt])
  @@index([reviewedByUserId])
  @@map("check_ins")
}

model ClientMeasurement {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  clientId       String       @map("client_id")
  sourceType     String       @map("source_type")
  sourceId       String       @map("source_id")
  measuredAt     DateTime     @map("measured_at") @db.Timestamptz(6)
  metricKey      String       @map("metric_key")
  metricValue    Decimal      @map("metric_value") @db.Decimal(18, 6)
  unit           String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceType, sourceId, metricKey])
  @@index([organizationId, clientId, metricKey, measuredAt])
  @@index([organizationId, sourceType, sourceId])
  @@map("client_measurements")
}

model ExternalApiKey {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  name           String
  keyPrefix      String               @unique @map("key_prefix")
  keyHash        String               @map("key_hash")
  scopes         Json
  status         ExternalApiKeyStatus @default(ACTIVE)
  allowedIps     Json?                @map("allowed_ips")
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?            @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt     DateTime?            @map("last_used_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exportJobs     ExternalExportJob[]
  auditLogs      AuditLog[]

  @@index([organizationId, status])
  @@index([organizationId, expiresAt])
  @@map("external_api_keys")
}

model ExternalExportJob {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  apiKeyId        String?              @map("api_key_id")
  type            ExternalExportType
  format          ExternalExportFormat
  filters         Json?
  status          ExternalExportStatus @default(QUEUED)
  resultObjectKey String?              @map("result_object_key")
  errorMessage    String?              @map("error_message") @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey          ExternalApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([apiKeyId, createdAt])
  @@map("external_export_jobs")
}

model ExternalWebhookEndpoint {
  id                String                        @id @default(cuid())
  organizationId    String                        @map("organization_id")
  url               String
  description       String?
  eventTypes        Json                          @map("event_types")
  signingSecretHash String                        @map("signing_secret_hash")
  status            ExternalWebhookEndpointStatus @default(ACTIVE)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries        ExternalWebhookDelivery[]

  @@index([organizationId, status])
  @@map("external_webhook_endpoints")
}

model ExternalWebhookDelivery {
  id             String                        @id @default(cuid())
  organizationId String                        @map("organization_id")
  endpointId     String                        @map("endpoint_id")
  eventType      String                        @map("event_type")
  payloadJson    Json                          @map("payload_json")
  status         ExternalWebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                           @default(0) @map("attempt_count")
  nextRetryAt    DateTime?                     @map("next_retry_at") @db.Timestamptz(6)
  lastError      String?                       @map("last_error") @db.Text
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint       ExternalWebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextRetryAt])
  @@index([organizationId, endpointId, createdAt])
  @@map("external_webhook_deliveries")
}
