# Keep real values in Vercel/CI/local secret stores only.
# Do not commit populated .env files.

# Auth.js
# Generate with: pnpm dlx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Neon/PostgreSQL
# Runtime should use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"

# Migrations should use the direct host when available.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Optional local seed account. Do not use shared or production passwords.
DEMO_COACH_EMAIL=""
DEMO_COACH_PASSWORD=""

# Optional verbose Prisma logs for local debugging only.
PRISMA_DEBUG_LOGS="0"
