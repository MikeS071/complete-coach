# M1 UI preview does not require runtime environment variables.
#
# Future phases will require these values. Keep real values in Vercel/CI/local
# secret stores only. Do not commit populated .env files.

# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="replace-with-secret-from-secret-manager"
